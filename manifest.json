{
  "name": "My Dashboard New Tab",
  "short_name": "Dashboard",
  "description": "Set a personalized Dashboard as the new Tab-Page with Bookmark-Integration.",
  "version": "1.0",
  "manifest_version": 3,
  "icons": {
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "scripting", "bookmarks"],
  "host_permissions": ["https://gemini.google.com/*"]
}
